#!/usr/bin/env python3
"""Apply the Bru QML/Aurorae decoration and palette with a user-file backup."""
import argparse
import fcntl
import json
import os
import re
from pathlib import Path
import shutil
import subprocess
import sys
import uuid

ROOT = Path(__file__).resolve().parents[1]
THEME = "org.brutallos.bru"


from user_files import atomic, digest, snapshot, restore
sys.path.insert(0, str(ROOT / "apps/brutall-welcome"))
from identity import settings, read_settings, variant, palette, color_scheme


def destinations(config, data):
    source = ROOT / "plasma/aurorae" / THEME
    copied = [(path, data / "kwin/decorations" / THEME / path.relative_to(source))
              for path in sorted(source.rglob("*")) if path.is_file()]
    copied += [(path, data / "color-schemes" / path.name) for path in sorted((ROOT / "plasma/colors").glob("Bru*.colors"))]
    return copied, [target for _, target in copied] + [config / name for name in ("kwinrc", "auroraerc", "kdeglobals")]


def native(*args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise ValueError((result.stderr or result.stdout).strip()[:1500])
    return result.stdout.strip()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("plan", "apply", "rollback"))
    parser.add_argument("--mode", choices=("light", "dark"), default="light")
    parser.add_argument("--backup", type=Path)
    parser.add_argument("--theme", choices=("bru", "raio", "friends"))
    parser.add_argument("--variant")
    parser.add_argument("--accent", help="auto, #RGB ou #RRGGBB")
    parser.add_argument("--tinted", choices=("yes", "no"))
    args = parser.parse_args()
    try:
        config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
        data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
        state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "brutallos/appearance"
        if not all(path.is_absolute() for path in (config, data, state)):
            raise ValueError("Os diretórios XDG devem ser absolutos.")
        copied, legacy_paths = destinations(config, data)
        identity_path = config / "brutallos/interface.json"
        scheme_path = data / "color-schemes/BrutallIdentity.colors"
        paths = legacy_paths + [identity_path, scheme_path]
        identity = None
        if args.action != "rollback":
            previous = read_settings(identity_path)
            identity = settings(args.theme or previous["theme"], args.variant or previous["variant"],
                                previous["accent"] if args.accent is None else (None if args.accent == "auto" else args.accent),
                                previous["tinted"] if args.tinted is None else args.tinted == "yes", args.mode)
        if args.action == "plan":
            print(json.dumps({"identity": identity, "files": [str(path) for path in paths], "decoration": THEME}, indent=2))
            return 0
        kwrite = shutil.which("kwriteconfig6")
        colors = shutil.which("plasma-apply-colorscheme")
        qdbus = shutil.which("qdbus6") or shutil.which("qdbus-qt6") or "/usr/lib/qt6/bin/qdbus"
        if not kwrite or not colors or not Path(qdbus).is_file():
            raise ValueError("Execute numa sessão Plasma 6 com kwriteconfig6, plasma-apply-colorscheme e qdbus Qt 6.")
        native(qdbus, "org.kde.KWin", "/KWin", "org.freedesktop.DBus.Peer.Ping")
        info = native(qdbus, "org.kde.KWin", "/KWin", "org.kde.KWin.supportInformation")
        if not re.search(r"KWin version:\s*6\.", info):
            raise ValueError("Esta decoração exige KWin 6.")
        state.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (state / ".lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if args.action == "rollback":
                if args.backup is None: raise ValueError("Informe --backup com o arquivo do backup.")
                manifest = json.loads(args.backup.read_text())
                if manifest.get("schemaVersion") not in {1, 2}: raise ValueError("Backup inválido.")
                # Validate the backup belongs to this user's permitted destination set.
                expected = legacy_paths if manifest["schemaVersion"] == 1 else paths
                if {item["path"] for item in manifest["files"]} != {str(path) for path in expected}:
                    raise ValueError("O backup pertence a outros diretórios ou versão do tema.")
                restore(manifest["files"])
                native(qdbus, "org.kde.KWin", "/KWin", "org.kde.KWin.reconfigure")
                print("Configurações anteriores restauradas. Reabra os apps ou entre novamente para recarregar a paleta em todos eles.")
                return 0
            manifest = {"schemaVersion": 2, "identity": identity, "phase": "prepared", "files": snapshot(paths)}
            backup = state / (uuid.uuid4().hex + ".json")
            atomic(backup, json.dumps(manifest, indent=2).encode())
            print("Backup: " + str(backup), flush=True)
            try:
                for source, target in copied: atomic(target, source.read_bytes())
                p = palette(identity["accent"] or variant(identity["theme"], identity["variant"])["accent"], args.mode == "dark", identity["tinted"])
                template = ROOT / "plasma/colors" / ("BruDark.colors" if args.mode == "dark" else "BruLight.colors")
                atomic(scheme_path, color_scheme(template.read_text(), identity))
                for key, value in {"library": "org.kde.kwin.aurorae", "theme": THEME, "ButtonsOnLeft": "XIA", "ButtonsOnRight": ""}.items():
                    native(kwrite, "--file", str(config / "kwinrc"), "--group", "org.kde.kdecoration2", "--key", key, value)
                native(kwrite, "--file", str(config / "auroraerc"), "--group", THEME, "--key", "dark", "true" if args.mode == "dark" else "false")
                for key in ("paper", "ink"):
                    native(kwrite, "--file", str(config / "auroraerc"), "--group", THEME, "--key", key, p[key])
                # The CLI skips the current named scheme. Clear only that name
                # on disk, then let the native tool reload/broadcast our new colors.
                native(kwrite, "--file", str(config / "kdeglobals"), "--group", "General", "--key", "ColorScheme", "")
                native(kwrite, "--file", str(config / "kdeglobals"), "--group", "General", "--key", "AccentColor", "--delete")
                native(colors, "BrutallIdentity")
                native(qdbus, "org.kde.KWin", "/KWin", "org.kde.KWin.reconfigure")
                atomic(identity_path, (json.dumps(identity, indent=2) + "\n").encode())
                manifest["phase"] = "applied"
            except (OSError, ValueError, subprocess.SubprocessError):
                manifest["phase"] = "incomplete"
                raise
            finally:
                for item in manifest["files"]: item["after"] = digest(Path(item["path"]))
                atomic(backup, json.dumps(manifest, indent=2).encode())
            print("Interface aplicada: " + args.mode + ", " + p["accent"] + ". Reversão: brutall-appearance rollback --backup " + str(backup))
            return 0
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print("brutall-appearance: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
